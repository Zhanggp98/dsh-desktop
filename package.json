{
    "name": "dsh-desktop",
    "version": "0.1.1-rc.2",
    "description": "DeepSeek Harness 桌面应用（Electron 套壳）",
    "main": "electron/main.js",
    "author": "dsh-desktop",
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "sync-version": "node scripts/sync-version.js",
        "pack": "npm run sync-version && electron-builder --dir",
        "dist": "npm run sync-version && electron-builder --win nsis"
    },
    "devDependencies": {
        "electron": "^43.4.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.deepseek.harness.desktop",
        "productName": "DeepSeek Harness",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "electron/**/*",
            "build/icon.png",
            "build/tray.png",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "vendor/node",
                "to": "node"
            },
            {
                "from": "build/dsh-bundle.tar",
                "to": "dsh-bundle.tar"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon-blue.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "DeepSeek Harness"
        }
    }
}
